# Copy to .env.docker: cp .env.docker.example .env.docker
NODE_ENV=development
PORT=5003

# MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/careertrack
MONGO_URI=mongodb://mongo:27017/careertrack

JWT_SECRET=dev_jwt_secret_change_before_production
JWT_REFRESH_SECRET=dev_refresh_secret_change_before_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3003

# Docker internal service names (browser URLs stay localhost in compose environment)
RESUME_BUILDER_API_URL=http://resume-backend:5001/api/v1
RESUME_BUILDER_CLIENT_URL=http://localhost:3001
ATS_BACKEND_URL=http://ats-backend:5002/api
ATS_API_URL=http://ats-backend:5002/api
INTERNAL_SYNC_KEY=internal_secret_key

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=CareerTrack <noreply@careertrack.com>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
