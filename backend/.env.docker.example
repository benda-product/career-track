# Copy to .env.docker: cp .env.docker.example .env.docker
NODE_ENV=development
PORT=5003

# MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/careertrack
MONGO_URI=mongodb://mongo:27017/careertrack

JWT_SECRET=replace-with-unique-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-unique-refresh-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3003

# Docker internal service names (browser URLs stay localhost in compose environment)
RESUME_BUILDER_API_URL=http://resume-backend:5001/api/v1
RESUME_BUILDER_CLIENT_URL=http://localhost:3001
ATS_BACKEND_URL=http://ats-backend:5002/api
ATS_API_URL=http://ats-backend:5002/api
# Optional host fallback when Docker DNS to ats-backend is unavailable (local dev)
ATS_API_FALLBACK_URL=http://host.docker.internal:5002/api
# Production public fallback (local dev: leave empty or use localhost)
ATS_PUBLIC_API_URL=
TALENTDESK_PUBLIC_URL=http://localhost:3002
SKILL_TEST_API_URL=http://skillcheck-backend:5005/api
SKILL_TEST_CLIENT_URL=http://localhost:3005
INTERNAL_SYNC_KEY=replace-with-unique-internal-sync-key
BENDA_INFOTECH_API_URL=http://benda-infotech-backend:5004/api
BENDA_AUTH_URL=http://localhost:5004
BENDA_AUTH_ISSUER=http://localhost:5004
BENDA_AUTH_AUDIENCE=benda-ecosystem

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=CareerTrack <noreply@careertrack.com>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Billing (PayPal) — set BILLING_DEV_MODE=true for instant upgrades without PayPal
BILLING_DEV_MODE=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
